<plist version="1.0">
<dict>
  <key>Label</key><string>com.tokenrouter.refresh</string>
  <key>ProgramArguments</key>
  <array><string>__ROOT__/scripts/monthly_refresh.sh</string></array>
  <key>StartCalendarInterval</key>
